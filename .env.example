# 복사해서 .env 로 사용. .env 는 커밋 금지.
DATABASE_URL=postgresql+asyncpg://saipr:saipr@localhost:5432/saipr

# 비워두면 해당 소스는 자동 비활성화 (Gutendex·위키문헌·Google Books는 키 없이 동작)
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=
WIKISOURCE_LANG=ko

# 세션 서명 키 (운영 필수): python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=false

# 시연·로컬 전용: 최소 체류시간 배율 (운영은 1.0)
DWELL_SCALE=1.0

# 가입 인증 메일: 로컬·일반 서버는 SMTP(Gmail 앱 비밀번호) 우선, Vercel은 Resend 우선(SMTP가 끊김).
# 둘 다 비우면 로컬은 코드를 서버 로그에만 남기고, Vercel(VERCEL_ENV 있음)은 발송 실패로 처리한다
SMTP_USER=
SMTP_PASSWORD=
# Resend
RESEND_API_KEY=
RESEND_FROM="해독 <onboarding@resend.dev>"

# --- 운영(ops) ---
# Sentry DSN — 비우면 오류 수집 안 함
SENTRY_DSN=
# 로그: JSON 한 줄(서버) / 텍스트(로컬). 레벨은 INFO·DEBUG
LOG_JSON=true
LOG_LEVEL=INFO
# CSP를 Report-Only로 낼지(true). 인라인 스크립트를 모두 nonce로 바꾼 뒤 false로 강제한다
CSP_REPORT_ONLY=true
