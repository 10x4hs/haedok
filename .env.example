# 복사해서 .env 로 사용해요. .env 는 커밋 금지. 기준과 기본값은 app/core/config.py, 설명은 README의 '환경 변수'.
# 비워 둔 줄은 기본값을 써요. 값은 모두 자리표시예요 — 진짜 키를 여기에 적지 마세요.

# --- DB ---
# 로컬 Postgres(docker compose). Neon은 postgres://…?sslmode=require 를 그대로 넣어도 돼요(asyncpg 형식으로 바뀌어요)
DATABASE_URL=postgresql+asyncpg://haedok:haedok@localhost:5432/haedok
# 로컬 시연은 SQLite가 편해요 — 앱이 시작할 때 표를 만들어요
# DATABASE_URL=sqlite+aiosqlite:///./scratch-dev.db

# --- 세션 · 보안 ---
# 운영 필수(Vercel에서 기본값이면 앱이 시작을 거부해요): python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
SESSION_IDLE_MINUTES=30
# HTTPS 배포에서는 true
COOKIE_SECURE=false
# CSP는 기본으로 강제(false). 위반을 살펴볼 때만 잠깐 true(Report-Only)
CSP_REPORT_ONLY=false
# /admin 을 열 수 있는 이메일(쉼표로 여러 개). 메일이 모두 실패하면 코드를 대신 받아요
ADMIN_EMAILS=

# --- 읽기 · 업로드 ---
# 쪽 읽기 시간 규칙(3~60초)의 배율 — 시연·로컬 전용(0.06이면 0.18~3.6초). 운영은 1.0
DWELL_SCALE=1.0
# 업로드 상한(MB). Vercel은 요청 본문을 4.5MB에서 끊으니 배포에서는 4
MAX_UPLOAD_MB=20

# --- 도서 소스 ---
# 비워 두면 그 소스만 꺼져요(Gutendex·위키문헌은 키 없이 동작)
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=
WIKISOURCE_LANG=ko
# 바깥 API 하나의 타임아웃(초)
HTTP_TIMEOUT_SECONDS=3.0
# 서점 검색: KAKAO_REST_API_KEY가 있으면 고른 책 밖의 책도 찾아요(공식, 무료).
# true는 키 없이 알라딘 검색 화면을 읽는 방식 — 알라딘 robots.txt가 막는 경로라 기본은 꺼 둬요
BOOKSTORE_LIVE=false

# --- 가입·비밀번호 코드 메일 ---
# 배포(Vercel)는 Apps Script → Brevo → Resend → SMTP, 로컬은 SMTP → Apps Script → Brevo → Resend 순서로 시도해요.
# 모두 비우면 로컬은 코드를 서버 로그에만 남기고, Vercel은 실패로 처리해요(그다음 ADMIN_EMAILS로 대신 보내 봐요)
# Google Apps Script 웹 앱(scripts/gas_mailer.gs) — URL과 스크립트에 넣은 비밀 문자열이 둘 다 있어야 켜져요
GAS_MAIL_URL=
GAS_MAIL_SECRET=
# Brevo — 도메인 없이 발신 주소 인증만으로 발송(무료 300통/일)
BREVO_API_KEY=
BREVO_FROM="해독 <you@example.com>"
# Resend — 도메인을 검증해야 본인 외에게도 보내요
RESEND_API_KEY=
RESEND_FROM="해독 <onboarding@resend.dev>"
# SMTP(Gmail은 계정 주소 + 16자리 앱 비밀번호). Vercel 함수에서는 끊겨요
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- 실시간 ---
# 친구 소식을 WebSocket으로 밀어 줄지. 비워 두면 로컬·도커는 켜고 Vercel은 꺼요(대신 폴링).
# 서버가 여러 대면 메모리 브로커가 다른 서버의 소식을 못 받으니, 공유 브로커를 붙이기 전에는 켜지 마세요
# REALTIME_WS=

# --- 기능 스위치 --- false면 입구가 숨고 주소는 404
FEATURE_GOALS=true
FEATURE_BOARD=true
FEATURE_CHAT=true
FEATURE_MILEAGE=true
FEATURE_POSTS=true

# --- 공개 주소 · 앱 ---
# canonical·OG·사이트맵·초대 미리보기에 쓰는 주소(끝 슬래시 없이). 비우면 Vercel URL → 요청 주소 순
SITE_URL=
APP_NAME=haedok
# Android TWA(/.well-known/assetlinks.json). 비우면 이 앱의 기본값. 지문은 쉼표로 여러 개
# ANDROID_PACKAGE=
# ANDROID_CERT_SHA256=

# --- 운영(ops) ---
# Sentry DSN — 비우면 오류 수집 안 함
SENTRY_DSN=
# 로그: JSON 한 줄(서버) / 텍스트(로컬, false). 레벨은 INFO·DEBUG
LOG_JSON=true
LOG_LEVEL=INFO

# --- Vercel이 넣어 주는 값(직접 적지 않아요) ---
# VERCEL · VERCEL_ENV · VERCEL_URL · VERCEL_PROJECT_PRODUCTION_URL
