{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "app/{templates,static,data}/**",
      "excludeFiles": "{tests/**,docs/**,scripts/**,public/**/*.mp4,**/*.apk}"
    }
  }
}
